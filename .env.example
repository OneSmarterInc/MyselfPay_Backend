DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://selfpay:selfpay@127.0.0.1:5432/selfpay?sslmode=disable
COOKIE_SAMESITE=Lax
# Maximum domain PostgreSQL connections per worker; 0 disables pooling.
SELFPAY_DB_POOL_SIZE=4
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKING_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MySelfPay
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Enable after the outbox migration and SMTP configuration are verified.
BOOKING_EMAIL_ENABLED=false
# During portal testing, set this to the test center recipient only.
BOOKING_EMAIL_ALLOWED_RECIPIENTS=
TEST_CENTER_EMAIL=

# Enable only after both services and the booking-chat migration are configured.
SECURE_MAIL_ENABLED=false
SECURE_MAIL_URL=https://securemailbackend.onesmarter.com
SECURE_MAIL_PORTAL_URL=https://securemail.onesmarter.com
SECURE_MAIL_KEY_ID=selfpay
SECURE_MAIL_SECRET=
SECURE_MAIL_ALLOW_LOOPBACK_HTTP=false
# Shared API host requires a trusted client certificate for the integration route.
# See SECURE_MAIL_SHARED_HOST_SETUP.md. Leave CA_FILE empty for public server trust.
SECURE_MAIL_CA_FILE=
SECURE_MAIL_CLIENT_CERT=/etc/selfpay/pki/integration-client.pem
SECURE_MAIL_CLIENT_KEY=/etc/selfpay/pki/integration-client.key
